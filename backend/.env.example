# TPG Backend Environment Configuration
# Copy this to .env and fill in real values.

# ─── Application ───────────────────────────────────────────
APP_NAME="TPG — The Product Guy"
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tpg
DATABASE_ECHO=false

# ─── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ──────────────────────────────────────────────
# API key for ChatGPT Actions authentication
API_KEY=tpg-dev-key-change-in-production

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=["https://chat.openai.com","https://chatgpt.com","http://localhost:3000"]
